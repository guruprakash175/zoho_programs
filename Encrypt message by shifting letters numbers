package practice_java;

public class demo {

    public static void main(String args[]) {

        String s = "AbcZ9";
        int shift = 2;

        char[] arr = s.toCharArray();

        for(int i = 0; i < arr.length; i++) {

            char ch = arr[i];

            // Lowercase
            if(ch >= 'a' && ch <= 'z') {
                arr[i] = (char)((ch - 'a' + shift) % 26 + 'a');
            }

            // Uppercase
            else if(ch >= 'A' && ch <= 'Z') {
                arr[i] = (char)((ch - 'A' + shift) % 26 + 'A');
            }

            // Digits
            else if(ch >= '0' && ch <= '9') {
                arr[i] = (char)((ch - '0' + shift) % 10 + '0');
            }
        }

        System.out.println(new String(arr));
    }
}

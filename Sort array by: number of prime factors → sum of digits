import java.util.*;

public class Demo {

    public static void main(String[] args) {

        Integer[] nums = {10, 7, 12, 9};

        Arrays.sort(nums, (a, b) -> {

            int pf1 = primeFactorCount(a);
            int pf2 = primeFactorCount(b);

            // Rule 1: Compare prime factor count
            if(pf1 != pf2)
                return pf1 - pf2;

            // Rule 2: Compare digit sum
            int sum1 = digitSum(a);
            int sum2 = digitSum(b);

            return sum1 - sum2;
        });

        System.out.println(Arrays.toString(nums));
    }

    // Count prime factors
    static int primeFactorCount(int n){
        int count = 0;

        for(int i = 2; i <= n; i++){
            while(n % i == 0){
                count++;
                n /= i;
            }
        }

        return count;
    }

    // Digit sum
    static int digitSum(int n){
        int sum = 0;

        while(n > 0){
            sum += n % 10;
            n /= 10;
        }

        return sum;
    }
}
